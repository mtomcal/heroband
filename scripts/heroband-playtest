#!/bin/sh
set -eu

usage() {
	cat <<'EOF'
Usage: scripts/heroband-playtest <command> [args]

Commands:
  prepare-scenario
             Generate an isolated scenario save and manifest for playtesting.
  start      Start an isolated GCU/tmux playtest session.
  capture    Capture the playtest pane and append transcript output.
  send       Send tmux keys, then capture the pane.
  stop       Stop or preserve the playtest tmux session.
  validate-evidence
             Validate a scenario evidence root before verifier/release reports.

Examples:
  scripts/heroband-playtest prepare-scenario corruption --state-dir /tmp/heroband-playtest.x
  scripts/heroband-playtest prepare-scenario general-l15-arrow-volley --state-dir /tmp/heroband-playtest.x
  scripts/heroband-playtest start --contract /tmp/heroband-playtest.x/TEST_CONTRACT.md
  scripts/heroband-playtest capture --state-dir /tmp/heroband-playtest.x
  scripts/heroband-playtest send --state-dir /tmp/heroband-playtest.x Space
  scripts/heroband-playtest stop --state-dir /tmp/heroband-playtest.x
  scripts/heroband-playtest validate-evidence --state-dir /tmp/heroband-playtest.x
EOF
}

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH= cd -- "$script_dir/.." && pwd)
skill_scripts="$repo_root/.agents/skills/heroband-playtest/scripts"

if [ "$#" -lt 1 ]; then
	usage >&2
	exit 2
fi

command=$1
shift

case "$command" in
	prepare-scenario)
		preset=${1:?"prepare-scenario requires a preset, such as corruption"}
		shift
		case "$preset" in
			-h|--help|help)
				usage
				;;
			corruption|corruption-smoke)
				exec "$repo_root/scripts/heroband-corruption-scenario-save" "$@"
				;;
			general-l01-smoke|general-l07-archer-withdrawal|\
			general-l15-arrow-volley|general-l30-charge-banner|\
			general-l45-banner-cleanup|general-moral-regression)
				exec "$repo_root/scripts/heroband-general-scenario-save" "$preset" "$@"
				;;
			*)
				echo "Unknown scenario preset: $preset" >&2
				echo "Known presets: corruption, corruption-smoke, general-l01-smoke, general-l07-archer-withdrawal, general-l15-arrow-volley, general-l30-charge-banner, general-l45-banner-cleanup, general-moral-regression" >&2
				exit 2
				;;
		esac
		;;
	start)
		exec "$skill_scripts/start-playtest.sh" "$@"
		;;
	capture)
		exec "$skill_scripts/capture-playtest.sh" "$@"
		;;
	send)
		exec "$skill_scripts/send-playtest-key.sh" "$@"
		;;
	stop)
		exec "$skill_scripts/stop-playtest.sh" "$@"
		;;
	validate-evidence)
		exec "$repo_root/scripts/heroband-validate-playtest-evidence" "$@"
		;;
	-h|--help|help)
		usage
		;;
	*)
		echo "Unknown command: $command" >&2
		usage >&2
		exit 2
		;;
esac
