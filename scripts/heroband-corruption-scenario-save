#!/bin/sh
set -eu

usage() {
	cat <<'EOF'
Usage: scripts/heroband-corruption-scenario-save --state-dir DIR [options]

Options:
  --state-dir DIR     Required isolated playtest state directory.
  --build-dir DIR     Build directory with unittest-game-basic. Defaults to build.
  --save-name NAME    Savefile basename. Defaults to current user name.
  -h, --help          Show this help.

Generates a temporary scenario save and SCENARIO_MANIFEST.md for GCU playtests.
EOF
}

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH= cd -- "$script_dir/.." && pwd)
state_dir=
build_dir="$repo_root/build"
save_name=$(id -un)

while [ "$#" -gt 0 ]; do
	case "$1" in
		--state-dir)
			state_dir=${2:?"--state-dir requires a directory"}
			shift 2
			;;
		--build-dir)
			build_dir=${2:?"--build-dir requires a directory"}
			shift 2
			;;
		--save-name)
			save_name=${2:?"--save-name requires a name"}
			shift 2
			;;
		-h|--help)
			usage
			exit 0
			;;
		*)
			echo "Unknown argument: $1" >&2
			usage >&2
			exit 2
			;;
	esac
done

if [ -z "$state_dir" ]; then
	echo "Missing required --state-dir DIR." >&2
	exit 2
fi

case "$build_dir" in
	/*) ;;
	*) build_dir="$repo_root/$build_dir" ;;
esac

mkdir -p "$state_dir/save" "$state_dir/user" "$state_dir/panic" "$state_dir/archive"

save_path="$state_dir/save/$save_name"
generator="$build_dir/unittests/game/basic/basic"

if [ ! -x "$generator" ]; then
	cmake --build "$build_dir" -t unittest-game-basic -j2
fi

if [ ! -x "$generator" ]; then
	echo "Missing scenario generator: $generator" >&2
	exit 1
fi

cat > "$state_dir/SCENARIO_MANIFEST.md" <<EOF
# Corruption Scenario Save

## Generator

- Generated UTC: $(date -u +%Y-%m-%dT%H:%M:%SZ)
- Repository: $repo_root
- Build directory: $build_dir
- Generator command: HEROBAND_SCENARIO_SAVE_OUT="$save_path" "$generator" -v
- Save path: $save_path
- Save name for GCU launch: $save_name

## Character State

- Name: Tester
- Race: Human
- Class: Warrior
- Level: 1
- Title: Rookie
- Depth: Town / 0
- Position: generated town start, on a down staircase
- Corruption: 7
- Expected corruption state: at or above aggravation threshold, below doomed threshold
- Stats: STR 18/20, INT 8, WIS 8, DEX 18, CON 18
- HP: 20/20
- SP: none for level-1 Warrior
- Armor class: 10
- Gold: 137
- Food: Fed, about 89 percent on first GCU capture
- Light radius: 1
- Equipment: starting melee weapon equipped; starting torch equipped; no armor
- Inventory: 2 Rations of Food, 1 Potion of Berserk Strength, 1 Scroll of Word of Recall, 2 Wooden Torches
- Learned powers/spells: none; level-1 Warrior has no spell realm or class powers
- Seed status: generated by the game/basic test frontend with normal Angband RNG state; exact state is serialized in the savefile
- Terrain: normal generated town, shops 1-8, player on a down staircase
- Monsters: normal generated town population; visible town monsters and positions are captured by the GCU transcript
- Pressure: low-pressure live-load scenario; intended to validate generated-save loading and UI interaction, not combat balance

## GCU Launch

\`\`\`sh
HOME="$state_dir" TERM=xterm-256color "$repo_root/build-gcu-test/game/angband" \\
  -duser="$state_dir/user" \\
  -dsave="$state_dir/save" \\
  -dpanic="$state_dir/panic" \\
  -darchive="$state_dir/archive" \\
  -u"$save_name" -mgcu
\`\`\`

## Expected Invariants

- The GCU frontend loads this save instead of entering birth.
- The loaded character reaches the normal town gameplay UI.
- Inventory can be opened, proving the session is live and player-visible.
- Scenario evidence is captured in TEST_CONTRACT.md, transcript.txt, and capture files.
EOF

HEROBAND_SCENARIO_SAVE_OUT="$save_path" "$generator" -v \
	> "$state_dir/scenario-generator.log" 2>&1

if [ ! -s "$save_path" ]; then
	echo "Scenario save was not created: $save_path" >&2
	exit 1
fi

{
	echo "Scenario state directory: $state_dir"
	echo "Scenario save: $save_path"
	echo "Manifest: $state_dir/SCENARIO_MANIFEST.md"
	echo "Generator log: $state_dir/scenario-generator.log"
} | tee "$state_dir/scenario-save.log"
